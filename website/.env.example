# Vorlage für Umgebungsvariablen. Kopieren nach `.env` (wird NICHT committet).
# Echte Werte gehören in GitHub → Settings → Secrets and variables → Actions → Variables
# (werden vom Deploy-Workflow beim Build gesetzt, siehe docs/eigentuemer-prinzip.md).
# Alle hier genannten Werte sind öffentlich sichtbar im Browser (Präfix PUBLIC_) – keine Geheimnisse.

# Optional: überschreibt die Domain aus src/config/site.ts (z. B. für Testumgebungen).
# Normalerweise leer lassen – die Domain wird zentral in site.ts gepflegt.
PUBLIC_SITE_URL=

# Google Analytics 4 Mess-ID (Format G-XXXXXXXXXX). Leer lassen = kein Tracking.
# Wird erst nach aktiver Einwilligung im Cookie-Banner geladen.
PUBLIC_GA4_ID=

# Endpunkt des Anfrageformulars (z. B. https://formspree.io/f/xxxxxxx – Konto der Kundin).
# Leer lassen = Formular zeigt stattdessen einen E-Mail-Link.
PUBLIC_FORM_ENDPOINT=

# Google Search Console Verifizierung per Meta-Tag (nur der content-Wert).
# Besser: Verifizierung per DNS-TXT-Eintrag bei der Domain (dann leer lassen).
PUBLIC_GSC_VERIFICATION=
